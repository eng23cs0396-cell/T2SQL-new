# NVIDIA NIM API Key (Required for Nemotron 3.5 Lightning)
NVIDIA_API_KEY=nvapi-your-key-here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Hardware / Model Settings
DEFAULT_DEVICE=cuda
MAX_SQL_EXECUTION_TIME=10
MAX_SQL_RESULT_ROWS=100
UPLOAD_DIR=data/databases
ADAPTER_OUTPUT_DIR=outputs/adapters
EVALUATION_OUTPUT_DIR=outputs/evaluation

